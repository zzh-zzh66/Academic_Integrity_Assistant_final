{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "consult_loop_config",
  "title": "咨询类循环检索配置（简化版）",
  "description": "咨询类意图的循环检索参数配置，优化为2轮循环",
  "version": "2.0.0",
  
  "config": {
    "model": "doubao-seed-1-8-251228",
    "temperature": 0.0,
    "top_p": 0.9,
    "max_completion_tokens": 500,
    "thinking": "disabled"
  },
  "sp": "循环检索配置文件（此字段仅用于满足LSP验证，实际不使用）",
  "up": "循环检索配置文件（此字段仅用于满足LSP验证，实际不使用）",
  
  "basic_params": {
    "max_rounds": 2,
    "target_score": 0.75,
    "min_score_threshold": 0.6,
    "time_limit_seconds": 15
  },
  
  "context_management": {
    "max_context_length": 500,
    "top_k_for_context": 3,
    "use_structured_context": true
  },
  
  "retrieval_params": {
    "first_round": {
      "top_k": 15,
      "min_score": 0.3
    },
    "second_round": {
      "top_k": 10,
      "min_score": 0.6
    }
  },
  
  "early_exit": {
    "enabled": true,
    "top_score_threshold": 0.85,
    "min_round_before_early_exit": 1
  },
  
  "decline_tolerance": {
    "enabled": true,
    "tolerance_rate": 0.05
  },
  
  "improvement_detection": {
    "enabled": true,
    "simple_convergence": true,
    "min_improvement": 0.05
  },
  
  "llm_enhancement": {
    "enable_improvement_prediction": false,
    "enable_complexity_adaptive": true
  },
  
  "node_configs": {
    "rerank": {
      "enabled": true,
      "config_file": "config/nodes/consult/consult_rerank_cfg.json"
    },
    "context_extract": {
      "enabled": true,
      "config_file": "config/nodes/consult/consult_context_extract_cfg.json",
      "execute_rounds": [0, 1]
    },
    "improvement_analysis": {
      "enabled": false
    }
  }
}
